<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog showHeader="false">
		<f:Form editable="true">
			<f:title>
				<core:Title text="{i18n>update}"/>
			</f:title>
			<f:layout>
				<f:ResponsiveGridLayout labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4"
					emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="{i18n>person}">
							<f:fields>
								<Input value="{TermService>FullName}" editable="false"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>taskText}">
							<f:fields>
								<TextArea rows="4" width="100%" id="CommentUpdateTask" value="{TermService>TaskText}" editable="true"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>term}">
							<f:fields>
								<DatePicker valueFormat="yyyyMMdd" value="{TermService>FinishDate}" placeholder=" " editable="true"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>status}">
							<f:fields>
								<ComboBox items="{path: 'TermService>/StatusTaskSet'}" selectedKey="{TermService>Status}">
									<core:Item key="{TermService>Status}" text="{TermService>Description}"/>
								</ComboBox>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
		<beginButton>
			<Button text="{i18n>save}" press="onUpdateSavePress"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>close}" press="onDestroyDialogWithReset"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>