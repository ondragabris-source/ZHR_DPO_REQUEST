<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog showHeader="false">
		<f:Form editable="true">
			<f:title>
				<core:Title text="{i18n>manageDeputy}" />
			</f:title>
			<f:layout>
				<f:ResponsiveGridLayout labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4"
					emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="{i18n>representative}">
							<f:fields>
								<Input id="SelectedPersonDeputy" value="{DeputyFullName}" editable="false" enabled="false"/>
							</f:fields>
						</f:FormElement>
						
						<f:FormElement label="{i18n>typeOfRepresentation}">
							<f:fields>
								<ComboBox items="{path: '/DeputyActivitySet'}" id="RoleDeputySelection">
									<core:Item key="{Activity}" text="{ActivityDesc}"/>
								</ComboBox>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
		<beginButton>
			<Button text="{i18n>save}" press="onEditDeputyConfirmPress"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>close}" press="onCloseDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>