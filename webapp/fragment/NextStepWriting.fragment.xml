<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog showHeader="false">
		<f:Form editable="true">
			<f:title>
				<core:Title text="{i18n>nextStep}"/>
			</f:title>
			<f:layout>
				<f:ResponsiveGridLayout labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4"
					emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="{i18n>writingStatus}">
							<f:fields>
								<Select id="NotifStatus" items="{TermService>/StatusNotifSet}" selectedKey="" forceSelection="false">
									<core:Item key="{TermService>Status}" text="{TermService>Description}"/>
								</Select>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>requestStatus}">
							<f:fields>
								<Select id="StatusRequest" items="{TermService>/StatusRequestSet}" selectedKey="" forceSelection="false">
									<core:Item key="{TermService>Status}" text="{TermService>Description}"/>
								</Select>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>comment}">
							<f:fields>
								<TextArea rows="4" width="100%" id="Comment" value="" editable="true"/>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
		<beginButton>
			<Button text="{i18n>save}" press="onNextStepConfirmPress"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>close}" press="onDestroyDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>