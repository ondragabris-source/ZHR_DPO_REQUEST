<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<SelectDialog title="{i18n>search}" items="{path: 'A004>/EmployeeSet', events: {dataReceived: '.onNewPersonsLoaded'}}" search=".onValueFmHelpSearch"
		confirm=".onValueHelpPersonChosen" cancel=".onCancelPress" >
		
		<ObjectListItem title="{A004>Fullname}" type="Active" press="onListItemPress"
			 numberUnit="{A004>Pernr}">
			<ObjectAttribute text="{A004>UnitShort}"/>
			<ObjectAttribute text="{A004>Role}"/>
			<ObjectAttribute text="{A004>Plans}"/>
		</ObjectListItem>
	</SelectDialog>
</core:FragmentDefinition>
