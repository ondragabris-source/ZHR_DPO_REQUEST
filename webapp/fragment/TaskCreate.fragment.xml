<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog showHeader="false" id="CreateTaskDialog">
		<f:Form editable="true">
			<f:title>
				<core:Title text="{i18n>newTask}"/>
			</f:title>
			<f:layout>
				<f:ResponsiveGridLayout labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4"
					emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="{i18n>responsiblePerson}">
							<f:fields>
								<Input showValueHelp="true" valueHelpOnly="true" valueHelpRequest="onPeopleValueHelpRequest" id="SelectedPersonDeputy"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>taskText}">
							<f:fields>
								<TextArea rows="4" width="100%" id="CommentNewTask" value="" editable="true"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>term}">
							<f:fields>
								<DatePicker valueFormat="yyyyMMdd" placeholder=" " id="termNewTask" editable="true"/>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
		<beginButton>
			<Button text="{i18n>create}" press="onCreateTaskConfirmPress"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>close}" press="onDestroyDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>