<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog showHeader="false">
		<f:Form editable="true">
			<f:title>
				<core:Title text="{i18n>changeStatus}"/>
			</f:title>
			<f:layout>
				<f:ResponsiveGridLayout labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4"
					emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="{i18n>statusDescr}">
							<f:fields>
								<ComboBox items="{path: 'TermService>/StatusSet'}" id="TermNewStatus">
									<core:ListItem key="{TermService>StatusTerm}" text="{TermService>Description}"/>
								</ComboBox>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
		<beginButton>
			<Button text="{i18n>save}" press="onChangeTermStatusConfirmPress"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>close}" press="onDestroyDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>