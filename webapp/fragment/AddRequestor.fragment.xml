<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog showHeader="false">
		<f:Form editable="true">
			<f:title>
				<core:Title text="{i18n>add}"/>
			</f:title>
			<f:layout>
				<f:ResponsiveGridLayout labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4"
					emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="{i18n>role}">
							<f:fields>
								<Select selectedKey="A" items="{ path: '/RoleNextSet' }" change="onRoleChange" id="RoleDeputySelection">
									<core:Item key="{Role}" text="{RoleDescr}"/>
								</Select>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="{i18n>name}">
							<f:fields>
								<Input showValueHelp="true" valueHelpOnly="true" valueHelpRequest="onPeopleValueHelpRequest" id="SelectedPersonDeputy"></Input>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
		<beginButton>
			<Button text="{i18n>save}" press="onCreateAdditionalRequestor"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>close}" press="onCloseDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>